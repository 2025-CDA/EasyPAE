<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Fiche de renseignement - {{ infoFormIntern.firstName }} {{ infoFormIntern.lastName }}</title>
    <style>
        :root {
            --primary-blue: #3B82F6;
            --text-dark: #1F2937;
            --text-medium: #4B5563;
            --text-light: #9CA3AF;
            --border-color: #E5E7EB;
            --background-light: #F9FAFB;
            --background-white: #FFFFFF;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: var(--background-light);
            color: var(--text-medium);
            margin: 0;
            padding: 1.5rem; /* Reduced padding */
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
        }

        /* --- HEADER & BREADCRUMBS --- */
        .page-header {
            margin-bottom: 1.5rem; /* Reduced margin */
        }

        .page-header h1 {
            font-size: 2rem;
            color: var(--text-dark);
            font-weight: 700;
            margin: 0;
        }

        /* --- CARD STYLES --- */
        .card {
            background-color: var(--background-white);
            border: 1px solid var(--border-color);
            border-radius: 0.75rem;
            padding: 1.5rem; /* Reduced padding */
            margin-bottom: 1.25rem; /* Reduced margin */
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-blue);
            margin-bottom: 1.5rem; /* Reduced margin */
        }

        .section-title {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--primary-blue);
            margin-bottom: 1.25rem; /* Reduced margin */
            margin-top: 1.5rem; /* Reduced margin */
        }
        .section-title:first-child {
            margin-top: 0;
        }

        /* --- FIELD STYLES --- */
        .field-group {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem; /* Reduced margin */
        }

        .field-group label {
            font-weight: 600;
            color: var(--text-dark);
        }

        .field-group .value-container {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .field-group .value {
            color: var(--text-medium);
        }

        .copy-icon {
            color: var(--text-light);
            width: 16px;
            height: 16px;
            cursor: pointer;
            transition: color 0.2s;
        }
        .copy-icon:hover {
            color: var(--text-medium);
        }

        /* Field styles for boxed inputs */
        .field-group-boxed {
            margin-bottom: 1rem;
        }

        .field-group-boxed label {
            display: block;
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
            color: var(--text-dark);
        }

        .field-group-boxed .value-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.6rem 0.8rem;
            border: 1px solid var(--border-color);
            border-radius: 0.375rem;
            background-color: var(--background-light);
        }

        /* --- LAYOUT GRID --- */
        .layout-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem; /* Reduced gap */
            align-items: start;
        }

        .grid-column {
            display: flex;
            flex-direction: column;
            gap: 1.25rem; /* Reduced gap */
        }

    </style>
</head>
<body>

<div class="container">

    <header class="page-header">
        <h1>Fiches de renseignement</h1>
    </header>

    <!-- ======== CARD 1: STAGIAIRE (Full Width) ======== -->
    <div class="card">
        <h2 class="card-title">STAGIAIRE : {{ infoFormIntern.firstName }} {{ infoFormIntern.lastName }}</h2>

        <!-- Personal Info Section -->
        <div class="section">
            <h3 class="section-title">Informations personnelles</h3>
            <div class="field-group">
                <label>Prénom :</label>
                <div class="value-container">
                    <span class="value">{{ infoFormIntern.firstName }}</span>
                    {% include 'partials/_copy_icon.svg' %}
                </div>
            </div>
            <div class="field-group">
                <label>Nom :</label>
                <div class="value-container">
                    <span class="value">{{ infoFormIntern.lastName }}</span>
                    {% include 'partials/_copy_icon.svg' %}
                </div>
            </div>
            <div class="field-group">
                <label>Email :</label>
                <div class="value-container">
                    <span class="value">{{ infoFormIntern.email }}</span>
                    {% include 'partials/_copy_icon.svg' %}
                </div>
            </div>
            <div class="field-group">
                <label>Formation :</label>
                <div class="value-container">
                    <span class="value">{{ infoForm.trainingSession.training.name }}</span>
                    {% include 'partials/_copy_icon.svg' %}
                </div>
            </div>
        </div>

        <!-- Internship Period Section -->
        <div class="section">
            <h3 class="section-title">Période en entreprise</h3>
            <div class="field-group">
                <label>Dates</label>
                <div class="value-container">
                    <span class="value">Du {{ infoFormIntern.dateStart|date('d F Y') }} au {{ infoFormIntern.dateEnd|date('d F Y') }}</span>
                    {% include 'partials/_copy_icon.svg' %}
                </div>
            </div>
        </div>

        <!-- "L'entreprise d'accueil" section has been removed from this card -->

    </div>

    <!-- ======== LAYOUT GRID: Company Details & Contacts ======== -->
    <div class="layout-grid">

        <!-- Left Column -->
        <div class="grid-column">
            <!-- ======== CARD 2: L'ENTREPRISE ======== -->
            <div class="card">
                <h3 class="section-title">L'entreprise</h3>
                <div class="field-group-boxed">
                    <label>Nom de l'entreprise</label>
                    <div class="value-box">
                        <span>{{ infoFormCompany.name }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
                <div class="field-group-boxed">
                    <label>Adresse de l'entreprise</label>
                    <div class="value-box">
                        <span>{{ infoFormCompany.address }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
                <div class="field-group-boxed">
                    <label>Activité</label>
                    <div class="value-box">
                        <span>{{ infoFormCompany.activity }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
                <div class="field-group-boxed">
                    <label>Téléphone</label>
                    <div class="value-box">
                        <span>{{ infoFormCompany.tutorPhoneNumber }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
                <div class="field-group-boxed">
                    <label>Mail</label>
                    <div class="value-box">
                        <span>{{ infoFormCompany.email }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
                <div class="field-group-boxed">
                    <label>Fax</label>
                    <div class="value-box">
                        <span>{{ infoFormCompany.fax | default('N/A') }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
                <div class="field-group-boxed">
                    <label>N° SIRET</label>
                    <div class="value-box">
                        <span>{{ infoForm.companyMembers.first.company.siret }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="grid-column">
            <!-- ======== CARD 3: RESPONSABLE LEGAL ======== -->
            <div class="card">
                <h3 class="section-title">Responsable légal(e)</h3>
                <div class="field-group-boxed">
                    <label>Nom</label>
                    <div class="value-box">
                        <span>{{ infoFormCompany.legalRepresentativeLastName }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
                <div class="field-group-boxed">
                    <label>Prénom</label>
                    <div class="value-box">
                        <span>{{ infoFormCompany.legalRepresentativeFirstName }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
                <div class="field-group-boxed">
                    <label>Mail</label>
                    <div class="value-box">
                        <span>{{ infoFormCompany.legalRepresentativeEmail }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
            </div>

            <!-- ======== CARD 4: TUTEUR/TRICE ======== -->
            <div class="card">
                <h3 class="section-title">Tuteur/tutrice</h3>
                <div class="field-group-boxed">
                    <label>Nom</label>
                    <div class="value-box">
                        <span>{{ infoFormCompany.tutorLastName }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
                <div class="field-group-boxed">
                    <label>Prénom</label>
                    <div class="value-box">
                        <span>{{ infoFormCompany.tutorFirstName }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
                <div class="field-group-boxed">
                    <label>Mail</label>
                    <div class="value-box">
                        <span>{{ infoFormCompany.tutorEmail }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
                <div class="field-group-boxed">
                    <label>Téléphone</label>
                    <div class="value-box">
                        <span>{{ infoFormCompany.tutorPhoneNumber }}</span>
                        {% include 'partials/_copy_icon.svg' %}
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

</body>
</html>
