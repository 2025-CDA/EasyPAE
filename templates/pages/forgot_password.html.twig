<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>EasyPAE - Mot de passe oublié</title>
</head>
<body>
    <h1>Mot de passe oublié</h1>
    
    {% if success is defined and success %}
        <div style="color: green;">
            <p>✅ Un email de réinitialisation a été envoyé à votre adresse email.</p>
        </div>
    {% elseif error is defined and error %}
        <div style="color: red;">
            <p>❌ {{ error }}</p>
        </div>
    {% endif %}
    
    {% if not (success is defined and success) %}
    <p>Entrez votre adresse email pour recevoir un lien de réinitialisation :</p>
    {% endif %}
    
    {% if not (success is defined and success) %}
    <form method="POST" action="/forgot-password">
        <div>
            <label for="email">Email :</label><br>
            <input type="email" id="email" name="email" required>
        </div>
        <br>
        
        <div>
            <button type="submit">Envoyer le lien</button>
        </div>
    </form>
    {% endif %}
    
    <hr>
    
    <div>
        <a href="/login">
            <button type="button">Retour à la connexion</button>
        </a>
    </div>
</body>
</html>